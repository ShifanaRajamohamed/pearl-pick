# ==========================================
# PEARL PICK! - Environment Configuration
# ==========================================

# Google Gemini API Key (Required for AI dress generation, tailor matching, and chat assistance)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Server Port (Default: 3000)
PORT=3000

# Public Application URL (used for self-referential links & callbacks)
APP_URL=http://localhost:3000
